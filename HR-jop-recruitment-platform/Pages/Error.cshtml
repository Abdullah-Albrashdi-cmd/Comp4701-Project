@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state my-5">
    <span class="eyebrow">SOMETHING WENT WRONG</span>
    <h1 class="h2 mt-2">We could not complete that request.</h1>
    <p class="text-secondary">Please try again. If the problem continues, return to the job listings.</p>
    <a asp-page="/Index" class="btn btn-primary">Back to jobs</a>
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary mt-3 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>
